    "smoke": "node tools/smoke.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^25.17.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
